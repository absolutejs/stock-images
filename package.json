{
  "name": "@absolutejs/stock-images",
  "version": "0.1.0",
  "description": "Provider-neutral stock photo search, selection, attribution and typed failure contracts.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/stock-images.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && absolute-manifest emit",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests package.json README.md",
    "check:package": "bun run typecheck && bun run test && bun run build && absolute-manifest verify-package",
    "prepublishOnly": "bun run check:package"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.10.0",
    "@sinclair/typebox": "^0.34.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.0"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
